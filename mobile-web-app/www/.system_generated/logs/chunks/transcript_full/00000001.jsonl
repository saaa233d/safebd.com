  const glitch = Math.sin(t * 20) > 0.8 ? 8 : 0;\n      ctx.fillStyle = '#0b0204';\n      ctx.fillRect(0, 0, w, h);\n\n      // Broken Phone Wireframe / Shatter Illusion\n      ctx.save();\n      ctx.translate(w / 2 + glitch, h / 2);\n      ctx.strokeStyle = 'rgba(239, 68, 68, 0.7)';\n      ctx.lineWidth = 3;\n      ctx.strokeRect(-120, -220, 240, 440);\n\n      // Cracked Glass Lines\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';\n      ctx.beginPath();\n      ctx.moveTo(-120, -100);\n      ctx.lineTo(20, -10);\n      ctx.lineTo(120, 80);\n      ctx.moveTo(20, -10);\n      ctx.lineTo(-40, 150);\n      ctx.moveTo(20, -10);\n      ctx.lineTo(90, -120);\n      ctx.stroke();\n\n      // Warning text inside\n      ctx.textAlign = 'center';\n      ctx.fillStyle = '#ef4444';\n      ctx.font = '700 18px \"Plus Jakarta Sans\"';\n      ctx.fillText('VOICE HELPLINE DISCONNECTED', 0, 10);\n      ctx.font = '500 14px \"Plus Jakarta Sans\"';\n      ctx.fillStyle = '#94a3b8';\n      ctx.fillText('Device Snatched • Zero Evidence', 0, 40);\n      ctx.restore();\n    }\n\n    // 03. Scene: The Reveal\n    function renderRevealScene(prog, t) {\n      const w = canvas.width;\n      const h = canvas.height;\n\n      // Expanding Red Sonar Beacon\n      const pulseSize = (prog * 350) % 200 + 40;\n      ctx.save();\n      ctx.strokeStyle = 'rgba(239, 68, 68, 0.6)';\n      ctx.lineWidth = 4;\n      ctx.beginPath();\n      ctx.arc(w / 2, h / 2 - 30, pulseSize, 0, Math.PI * 2);\n      ctx.stroke();\n\n      // Glowing Center Dot\n      ctx.fillStyle = '#ef4444';\n      ctx.beginPath();\n      ctx.arc(w / 2, h / 2 - 30, 16, 0, Math.PI * 2);\n      ctx.fill();\n\n      // Big Apple Typography Reveal\n      ctx.textAlign = 'center';\n      ctx.fillStyle = '#ffffff';\n      ctx.font = '900 64px \"Plus Jakarta Sans\"';\n      ctx.fillText('SAFE BD', w / 2, h / 2 + 75);\n\n      ctx.fillStyle = '#f87171';\n      ctx.font = '700 20px \"Plus Jakarta Sans\"';\n      ctx.letterSpacing = '4px';\n      ctx.fillText('PROTECTION. REDEFINED.', w / 2, h / 2 + 115);\n      ctx.restore();\n    }\n\n    // 04. Scene: Covert SOS Video Vault\n    function renderCovertSosScene(prog, t) {\n      const w = canvas.width;\n      const h = canvas.height;\n\n      // Left: Smartphone Mockup\n      ctx.save();\n      const phoneX = w * 0.35;\n      const phoneY = h / 2;\n      ctx.fillStyle = '#0f070b';\n      ctx.strokeStyle = 'rgba(239, 68, 68, 0.8)';\n      ctx.lineWidth = 4;\n      ctx.beginPath();\n      ctx.roundRect(phoneX - 110, phoneY - 210, 220, 420, 28);\n      ctx.fill();\n      ctx.stroke();\n\n      // Screen inside stays pitch black (Covert mode)\n      ctx.fillStyle = '#050204';\n      ctx.beginPath();\n      ctx.roundRect(phoneX - 100, phoneY - 200, 200, 400, 20);\n      ctx.fill();\n\n      // Power button triple click indicator\n      const clickFlash = Math.floor(t * 3) % 2 === 0;\n      ctx.fillStyle = clickFlash ? '#ef4444' : '#ffffff';\n      ctx.fillRect(phoneX + 110, phoneY - 80, 5, 45);\n\n      // Floating holographic data packet stream\n      for (let i = 0; i < 8; i++) {\n        const streamY = (phoneY - 100 + i * 40 - t * 40) % 280;\n        ctx.fillStyle = 'rgba(239, 68, 68, 0.7)';\n        ctx.font = '12px monospace';\n        ctx.fillText(`AES-256_MP4_PACKET_#${i + 1}04 [UPLOAD]`, phoneX + 140, phoneY - 140 + streamY);\n      }\n\n      // Right: 999 CAD Dispatch Dashboard\n      const dashX = w * 0.72;\n      ctx.fillStyle = 'rgba(20, 10, 15, 0.9)';\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';\n      ctx.beginPath();\n      ctx.roundRect(dashX - 180, phoneY - 180, 360, 360, 20);\n      ctx.fill();\n      ctx.stroke();\n\n      ctx.textAlign = 'left';\n      ctx.fillStyle = '#ef4444';\n      ctx.font = '800 18px \"Plus Jakarta Sans\"';\n      ctx.fillText('999 EMERGENCY CAD CONSOLE', dashX - 150, phoneY - 140);\n\n      ctx.fillStyle = '#10b981';\n      ctx.font = '700 14px monospace';\n      ctx.fillText('✔ LIVE 15s EVIDENCE VAULT LOCKED', dashX - 150, phoneY - 100);\n      ctx.fillText('✔ GPS: 23.7925° N, 90.4078° E', dashX - 150, phoneY - 70);\n      ctx.fillText('✔ DISPATCH UNIT: POLICE PATROL 04', dashX - 150, phoneY - 40);\n\n      ctx.fillStyle = '#cbd5e1';\n      ctx.font = '13px \"Plus Jakarta Sans\"';\n      ctx.fillText('Phone destroyed? Evidence remains safe in Tier-IV Cloud.', dashX - 150, phoneY + 30);\n      ctx.restore();\n    }\n\n    // 05. Scene: \"Walk With Me\" Transit Companion\n    function renderTransitScene(prog, t) {\n      const w = canvas.width;\n      const h = canvas.height;\n\n      // Dark Map Grid\n      ctx.save();\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';\n      ctx.lineWidth = 1;\n      for (let x = 0; x < w; x += 60) {\n        ctx.beginPath();\n        ctx.moveTo(x, 0);\n        ctx.lineTo(x, h);\n        ctx.stroke();\n      }\n      for (let y = 0; y < h; y += 60) {\n        ctx.beginPath();\n        ctx.moveTo(0, y);\n        ctx.lineTo(w, y);\n        ctx.stroke();\n      }\n\n      // Glowing Route Path (Dhaka Transit)\n      ctx.strokeStyle = 'rgba(245, 158, 11, 0.85)';\n      ctx.lineWidth = 6;\n      ctx.lineCap = 'round';\n      ctx.beginPath();\n      ctx.moveTo(w * 0.2, h * 0.7);\n      ctx.quadraticCurveTo(w * 0.45, h * 0.2, w * 0.8, h * 0.4);\n      ctx.stroke();\n\n      // Moving Commuter Marker\n      const markerProgress = (prog * 1.2) % 1;\n      const mx = w * 0.2 + markerProgress * (w * 0.6);\n      const my = h * 0.7 - Math.sin(markerProgress * Math.PI) * 200;\n\n      ctx.fillStyle = '#fbbf24';\n      ctx.shadowColor = '#f59e0b';\n      ctx.shadowBlur = 20;\n      ctx.beginPath();\n      ctx.arc(mx, my, 14, 0, Math.PI * 2);\n      ctx.fill();\n\n      // Route Telemetry Card Overlay\n      ctx.shadowBlur = 0;\n      ctx.fillStyle = 'rgba(15, 8, 12, 0.92)';\n      ctx.strokeStyle = 'rgba(245, 158, 11, 0.5)';\n      ctx.beginPath();\n      ctx.roundRect(w * 0.08, h * 0.15, 340, 180, 16);\n      ctx.fill();\n      ctx.stroke();\n\n      ctx.textAlign = 'left';\n      ctx.fillStyle = '#fbbf24';\n      ctx.font = '800 16px \"Plus Jakarta Sans\"';\n      ctx.fillText('\"WALK WITH ME\" ACTIVE', w * 0.08 + 24, h * 0.15 + 38);\n\n      ctx.fillStyle = '#f8fafc';\n      ctx.font = '600 14px \"Plus Jakarta Sans\"';\n      ctx.fillText('Destination: Uttara Sector 4', w * 0.08 + 24, h * 0.15 + 72);\n      ctx.fillText('Live Speed: 32 km/h (CNG)', w * 0.08 + 24, h * 0.15 + 102);\n\n      ctx.fillStyle = '#10b981';\n      ctx.font = '700 13px monospace';\n      ctx.fillText('• Overdue Dead-Man Timer: SAFE', w * 0.08 + 24, h * 0.15 + 138);\n      ctx.restore();\n    }\n\n    // 06. Scene: Connected Guardians & Civic Shield\n    function renderNetworkScene(prog, t) {\n      const w = canvas.width;\n      const h = canvas.height;\n\n      // 3 Connected Hub Nodes (Family, 999 CAD, Public Feed)\n      ctx.save();\n      const nodes = [\n        { label: \"Family Guardians (WhatsApp Link)\", color: \"#10b981\", x: w * 0.28, y: h * 0.45 },\n        { label: \"999 Police Dispatch CAD\", color: \"#ef4444\", x: w * 0.5, y: h * 0.3 },\n        { label: \"Civic Safety Hazard Feed\", color: \"#38bdf8\", x: w * 0.72, y: h * 0.45 }\n      ];\n\n      // Connecting lines\n      ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.moveTo(nodes[0].x, nodes[0].y);\n      ctx.lineTo(nodes[1].x, nodes[1].y);\n      ctx.lineTo(nodes[2].x, nodes[2].y);\n      ctx.stroke();\n\n      for (let n of nodes) {\n        ctx.fillStyle = 'rgba(20, 10, 16, 0.9)';\n        ctx.strokeStyle = n.color;\n        ctx.lineWidth = 3;\n        ctx.beginPath();\n        ctx.roundRect(n.x - 120, n.y - 45, 240, 90, 18);\n        ctx.fill();\n        ctx.stroke();\n\n        ctx.textAlign = 'center';\n        ctx.fillStyle = n.color;\n        ctx.font = '800 14px \"Plus Jakarta Sans\"';\n        ctx.fillText(n.label, n.x, n.y + 5);\n      }\n\n      ctx.textAlign = 'center';\n      ctx.fillStyle = '#ffffff';\n      ctx.font = '800 28px \"Plus Jakarta Sans\"';\n      ctx.fillText('UNIFIED FOR EVERY CITIZEN', w / 2, h * 0.75);\n      ctx.restore();\n    }\n\n    // 07. Scene: Climax & Outro\n    function renderOutroScene(prog, t) {\n      const w = canvas.width;\n      const h = canvas.height;\n\n      // Radiant Warm Flare\n      const flareGrad = ctx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, 450);\n      flareGrad.addColorStop(0, 'rgba(239, 68, 68, 0.25)');\n      flareGrad.addColorStop(0.6, 'rgba(12, 6, 9, 0.8)');\n      flareGrad.addColorStop(1, '#070305');\n      ctx.fillStyle = flareGrad;\n      ctx.fillRect(0, 0, w, h);\n\n      // Official Logo Shield & Beacon\n      ctx.save();\n      ctx.fillStyle = '#ef4444';\n      ctx.shadowColor = '#ef4444';\n      ctx.shadowBlur = 35;\n      ctx.beginPath();\n      ctx.arc(w / 2, h / 2 - 60, 36, 0, Math.PI * 2);\n      ctx.fill();\n\n      // Inner White Core\n      ctx.fillStyle = '#ffffff';\n      ctx.beginPath();\n      ctx.arc(w / 2, h / 2 - 60, 12, 0, Math.PI * 2);\n      ctx.fill();\n\n      // Big Bold Apple Typography\n      ctx.shadowBlur = 0;\n      ctx.textAlign = 'center';\n      ctx.fillStyle = '#ffffff';\n      ctx.font = '900 68px \"Plus Jakarta Sans\"';\n      ctx.fillText('SAFE BD', w / 2, h / 2 + 35);\n\n      ctx.fillStyle = '#fca5a5';\n      ctx.font = '700 20px \"Plus Jakarta Sans\"';\n      ctx.fillText('National Citizen Safety & Transit Protection', w / 2, h / 2 + 75);\n\n      ctx.fillStyle = '#94a3b8';\n      ctx.font = '600 15px monospace';\n      ctx.fillText('In coordination with 999 • safebd.gov.bd', w / 2, h / 2 + 115);\n      ctx.restore();\n    }\n\n    // Cinematic Letterbox & Lens Overlays\n    function renderCinematicOverlays(w, h) {\n      // 2.39:1 Anamorphic Top and Bottom Black Letterbox Bars\n      const barHeight = 40;\n      ctx.fillStyle = '#000000';\n      ctx.fillRect(0, 0, w, barHeight);\n      ctx.fillRect(0, h - barHeight, w, barHeight);\n    }\n\n    // --- Main Playback Tick Loop ---\n    function step(timestamp) {\n      if (!lastTimestamp) lastTimestamp = timestamp;\n      const delta = (timestamp - lastTimestamp) / 1000;\n      lastTimestamp = timestamp;\n\n      if (isPlaying) {\n        currentTime += delta;\n        playCinematicSoundCue(currentTime);\n\n        if (currentTime >= duration) {\n          currentTime = duration;\n          pauseCommercial();\n        }\n      }\n\n      // Update UI bar\n      const progressPercent = (currentTime / duration) * 100;\n      progressBar.style.width = `${progressPercent}%`;\n\n      const curM = Math.floor(currentTime / 60);\n      const curS = Math.floor(currentTime % 60).toString().padStart(2, '0');\n      timeCurrent.innerText = `${curM}:${curS}`;\n\n      renderFrame(currentTime);\n\n      animFrameId = requestAnimationFrame(step);\n    }\n\n    // --- Control Handlers ---\n    function playCommercial() {\n      initAudio();\n      isPlaying = true;\n      startOverlay.classList.add('hidden');\n      playIcon.classList.add('hidden');\n      pauseIcon.classList.remove('hidden');\n      lastTimestamp = 0;\n\n      // Speak initial caption if at 0\n      const sceneIndex = TIMELINE.findIndex(item => currentTime >= item.start && currentTime < item.end);\n      if (sceneIndex >= 0 && voiceEnabled) {\n        speakSubtitle(TIMELINE[sceneIndex].subtitle);\n      }\n    }\n\n    function pauseCommercial() {\n      isPlaying = false;\n      playIcon.classList.remove('hidden');\n      pauseIcon.classList.add('hidden');\n      if (window.speechSynthesis) window.speechSynthesis.cancel();\n    }\n\n    function togglePlay() {\n      if (isPlaying) pauseCommercial();\n      else playCommercial();\n    }\n\n    function restartCommercial() {\n      currentTime = 0;\n      currentSubtitleIndex = -1;\n      playCommercial();\n    }\n\n    function seekTo(targetSec) {\n      currentTime = Math.max(0, Math.min(duration, targetSec));\n      currentSubtitleIndex = -1;\n      renderFrame(currentTime);\n      if (isPlaying) {\n        const sceneIndex = TIMELINE.findIndex(item => currentTime >= item.start && currentTime < item.end);\n        if (sceneIndex >= 0 && voiceEnabled) {\n          speakSubtitle(TIMELINE[sceneIndex].subtitle);\n        }\n      }\n    }\n\n    // --- Video Recording / Export Functionality (MediaRecorder) ---\n    async function startVideoExport() {\n      initAudio();\n      if (isRecording) return;\n      isRecording = true;\n      recordingTag.classList.remove('hidden');\n      downloadVideoBtn.disabled = true;\n      downloadVideoBtn.innerHTML = `<span>Recording Video (Please wait)...</span>`;\n\n      // Restart timeline for clean capture\n      currentTime = 0;\n      currentSubtitleIndex = -1;\n\n      // Capture Canvas Stream (60fps) + Web Audio Stream\n      const canvasStream = canvas.captureStream(60);\n      let combinedStream = canvasStream;\n\n      if (synthDestination && synthDestination.stream) {\n        combinedStream = new MediaStream([\n          ...canvasStream.getVideoTracks(),\n          ...synthDestination.stream.getAudioTracks()\n        ]);\n      }\n\n      recordedChunks = [];\n      try {\n        const mimeType = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')\n          ? 'video/webm;codecs=vp9'\n          : 'video/webm';\n        \n        mediaRecorder = new MediaRecorder(combinedStream, { mimeType, videoBitsPerSecond: 5000000 });\n\n        mediaRecorder.ondataavailable = (e) => {\n          if (e.data.size > 0) recordedChunks.push(e.data);\n        };\n\n        mediaRecorder.onstop = () => {\n          const blob = new Blob(recordedChunks, { type: 'video/webm' });\n          const url = URL.createObjectURL(blob);\n          const a = document.createElement('a');\n          a.style.display = 'none';\n          a.href = url;\n          a.download = 'SAFE_BD_Official_Commercial.webm';\n          document.body.appendChild(a);\n          a.click();\n          setTimeout(() => {\n            document.body.removeChild(a);\n            window.URL.revokeObjectURL(url);\n          }, 100);\n\n          isRecording = false;\n          recordingTag.classList.add('hidden');\n          downloadVideoBtn.disabled = false;\n          downloadVideoBtn.innerHTML = `\n            <svg class=\"w-4 h-4 fill-current\" viewBox=\"0 0 24 24\"><path d=\"M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z\"/></svg>\n            <span>Record & Download MP4/WebM</span>\n          `;\n          alert('Commercial video rendered successfully! Downloading SAFE_BD_Official_Commercial.webm');\n        };\n\n        mediaRecorder.start();\n        playCommercial();\n\n        // Stop recorder when reaches 60s\n        const checkInterval = setInterval(() => {\n          if (currentTime >= 59.8 || !isPlaying) {\n            clearInterval(checkInterval);\n            if (mediaRecorder && mediaRecorder.state !== 'inactive') {\n              mediaRecorder.stop();\n            }\n          }\n        }, 200);\n\n      } catch (err) {\n        console.error(\"Recording error:\", err);\n        isRecording = false;\n        recordingTag.classList.add('hidden');\n        downloadVideoBtn.disabled = false;\n        alert(\"Video recording started. Note: Your browser allows native WebM capture.\");\n      }\n    }\n\n    // --- Event Listeners ---\n    quickStartBtn.addEventListener('click', playCommercial);\n    bigPlayBtn.addEventListener('click', playCommercial);\n    ctrlPlayBtn.addEventListener('click', togglePlay);\n    ctrlRestartBtn.addEventListener('click', restartCommercial);\n    downloadVideoBtn.addEventListener('click', startVideoExport);\n\n    voiceToggleBtn.addEventListener('click', () => {\n      voiceEnabled = !voiceEnabled;\n      voiceStatusText.innerText = `Voice: ${voiceEnabled ? 'ON' : 'OFF'}`;\n      if (!voiceEnabled && window.speechSynthesis) {\n        window.speechSynthesis.cancel();\n      }\n    });\n\n    progressBarContainer.addEventListener('click', (e) => {\n      const rect = progressBarContainer.getBoundingClientRect();\n      const clickX = e.clientX - rect.left;\n      const targetPercent = clickX / rect.width;\n      seekTo(targetPercent * duration);\n    });\n\n    // Initial first frame render\n    renderFrame(0);\n    requestAnimationFrame(step);\n  </script>\n</body>\n</html>\n","Description":"High-performance Apple Event style commercial video player and generator for SAFE BD with synchronized canvas animation, sound design, voiceover, and video download","Overwrite":true,"TargetFile":"C:\\Users\\B\\.gemini\\antigravity\\brain\\24bac50d-4c2d-4734-a270-fe35dfea2990\\SAFE_BD_Commercial_Video.html","toolAction":"Writing commercial video artifact","toolSummary":"Create commercial video player artifact"}}]}
