# ========================================================
# SAFE BD — Environment Configuration Template
# Set these variables in your hosting environment (e.g., Render Dashboard)
# ========================================================

# Founder & Chief Administrator Master Password
ADMIN_PASSWORD=your_secure_admin_password_here

# Supabase Cloud Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUB_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Google Drive Cloud Vault Integration (Optional)
GDRIVE_SECRET_KEY=your_vault_secret_key
GDRIVE_VAULT_URL=your_google_apps_script_url

PORT=5000
NODE_ENV=production
